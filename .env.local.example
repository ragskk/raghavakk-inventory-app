# Inventory app — local environment.
# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Data repo (SQLite-over-Octokit)
# ---------------------------------------------------------------------------
# Fine-grained PAT scoped to ragskk/raghavakk-inventory-data with
# contents:read + contents:write. Required for both the app and the
# scripts under scripts/.
GITHUB_TOKEN=

# Optional overrides — defaults shown.
# INVENTORY_DATA_OWNER=ragskk
# INVENTORY_DATA_REPO=raghavakk-inventory-data
# INVENTORY_DATA_BRANCH=main

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------
# AUTH_SECRET: 32+ bytes of random. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Web). Add http://localhost:3000/api/auth/callback/google
# and the Vercel preview / production URLs as authorized redirect URIs in the
# Google Cloud console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allow-list. Default if unset:
#   raghava.kk@gmail.com,raghavakkstudio@gmail.com
# AUTH_ALLOWLIST=raghava.kk@gmail.com,raghavakkstudio@gmail.com
